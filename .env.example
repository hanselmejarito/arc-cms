# Local Next.js → docker postgres
# Vercel / Supabase: DATABASE_URL = transaction pooler :6543?pgbouncer=true
DATABASE_URL=postgresql://arc:arc@localhost:5432/arc_clinic
# Supabase session pooler :5432 — used only for prisma migrate deploy
DIRECT_URL=postgresql://arc:arc@localhost:5432/arc_clinic
SESSION_SECRET=change-me-in-production
COOKIE_SECURE=false
# Local Next: http://localhost:3000
# Vercel: https://<app>.vercel.app
CLIENT_ORIGIN=http://localhost:3000
